# This template is only for an optional production-like local configuration.
# The public Docker demo uses SQLite and does not read this file.

APP_SECRET_KEY=replace-with-a-unique-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

DB_HOST=database-host
DB_PORT=3306
DB_NAME=coal_shipments
DB_USER=coal_app
DB_PASSWORD=replace-with-a-strong-password

UPLOADS_DIR=/app/uploads
BACKUP_DIR=/app/backups
TZ=Europe/Moscow
